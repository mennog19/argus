{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argus",
  "version": "0.1.1",
  "identifier": "dev.argus.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Argus",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Studio Helios",
    "copyright": "Copyright © 2026 Studio Helios",
    "category": "Utility",
    "shortDescription": "A local-first password manager for KeePass vaults",
    "longDescription": "Argus is a local-first desktop password manager that reads and writes standard KeePass (.kdbx) files, so your vaults stay portable to KeePass and KeePassXC. Your data never leaves your device.",
    "fileAssociations": [
      {
        "ext": ["kdbx"],
        "name": "KeePass Database",
        "description": "KeePass password database",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMDQ0NjE1RUE3NDg4N0IKUldSN2lIVHFGVVlFdjl0NnJtK3NUQytpK0lxNGpmYjFuMko4cnVQTUtuTjZIS05LakNQcGcvZzYK",
      "endpoints": ["https://github.com/mennog19/argus/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
